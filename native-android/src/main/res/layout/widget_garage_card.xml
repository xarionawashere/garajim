<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="32dp" android:layout_height="32dp" android:gravity="center" android:text="G" android:textColor="#FFF4E8" android:textStyle="bold" android:textSize="17sp" android:background="@drawable/widget_mark_bg" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginLeft="9dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GARAJIM KARTI" android:textColor="#F2A18A" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.1" />
            <TextView android:id="@+id/widget_card_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Garajın hazır" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/widget_card_switch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:text="⇄" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:padding="8dp" android:background="@drawable/widget_chip_bg" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/widget_card_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="İlk aracını ekle" android:textColor="#BEC9D5" android:textSize="10sp" android:maxLines="3" android:ellipsize="end" android:layout_marginTop="3dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp" android:background="@drawable/widget_panel_bg" android:padding="10dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="KİLOMETRE" android:textColor="#91A3B5" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_card_km" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#F6C47E" android:textSize="22sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <View android:layout_width="1dp" android:layout_height="36dp" android:background="#3C4B5B" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginLeft="12dp">
            <TextView android:id="@+id/widget_card_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 ARAÇ" android:textColor="#E8EDF3" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_card_fuel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Yakıt kaydı bekleniyor" android:textColor="#91A3B5" android:textSize="10sp" android:layout_marginTop="3dp" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/widget_card_service" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Garajını düzenli takip et" android:textColor="#7FE0B1" android:textSize="10sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="7dp" />
</LinearLayout>