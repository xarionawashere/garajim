<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="32dp" android:layout_height="32dp" android:gravity="center" android:text="🔧" android:textSize="17sp" android:background="@drawable/widget_chip_bg" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginLeft="9dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BAKIM TAKİBİ" android:textColor="#F2A18A" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.1" />
            <TextView android:id="@+id/widget_maintenance_vehicle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Garajım" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/widget_maintenance_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bakım planın" android:textColor="#91A3B5" android:textSize="11sp" android:layout_marginTop="9dp" />
    <TextView android:id="@+id/widget_maintenance_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Planlı bakım ekle" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <ProgressBar android:id="@+id/widget_maintenance_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="7dp" android:max="100" android:progress="0" android:progressTint="#63D6A5" android:progressBackgroundTint="#2B3641" android:layout_marginTop="4dp" />
    <TextView android:id="@+id/widget_maintenance_detail" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="bottom" android:text="Bakım kayıtlarını takip et" android:textColor="#B9C5D0" android:textSize="10sp" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="7dp" />
</LinearLayout>