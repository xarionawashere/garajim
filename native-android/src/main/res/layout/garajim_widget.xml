<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="11dp" android:background="@drawable/widget_bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Garajım" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_switch" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:visibility="gone" android:text="⇄" android:textColor="#F87171" android:textSize="11sp" android:textStyle="bold"
            android:paddingLeft="6dp" android:paddingRight="8dp" />
        <TextView android:id="@+id/widget_km" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="#9CA3AF" android:textSize="11sp" android:maxLines="1" />
    </LinearLayout>
    <TextView android:id="@+id/widget_plate" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Uygulamayı açıp araç ekleyin" android:textColor="#E5E7EB" android:textSize="12sp"
        android:maxLines="1" android:ellipsize="end" />

    <TextView android:id="@+id/widget_service" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:visibility="gone" android:text="" android:textColor="#34D399" android:textSize="11sp" android:textStyle="bold"
        android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp" />
    <ProgressBar android:id="@+id/widget_progress_ok" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:max="100" android:progress="0" android:visibility="gone"
        android:progressTint="#22C55E" android:progressBackgroundTint="#333333" android:layout_marginTop="2dp" />
    <ProgressBar android:id="@+id/widget_progress_warn" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:max="100" android:progress="0" android:visibility="gone"
        android:progressTint="#F59E0B" android:progressBackgroundTint="#333333" android:layout_marginTop="2dp" />
    <ProgressBar android:id="@+id/widget_progress_bad" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:max="100" android:progress="0" android:visibility="gone"
        android:progressTint="#EF4444" android:progressBackgroundTint="#333333" android:layout_marginTop="2dp" />

    <TextView android:id="@+id/widget_alert" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:visibility="gone" android:text="" android:textColor="#FBBF24" android:textSize="11sp"
        android:maxLines="1" android:ellipsize="end" android:layout_marginTop="3dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:layout_marginTop="6dp" android:gravity="bottom">
        <TextView android:id="@+id/widget_btn_fuel" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1"
            android:gravity="center" android:text="⛽&#10;Yakıt" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" android:lines="2"
            android:background="@drawable/widget_btn_bg" />
        <TextView android:id="@+id/widget_btn_km" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1"
            android:layout_marginLeft="5dp" android:gravity="center" android:text="🛣️&#10;KM" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" android:lines="2"
            android:background="@drawable/widget_btn_bg" />
        <TextView android:id="@+id/widget_btn_service" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1"
            android:layout_marginLeft="5dp" android:gravity="center" android:text="🔧&#10;Bakım" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" android:lines="2"
            android:background="@drawable/widget_btn_bg" />
        <TextView android:id="@+id/widget_btn_ride" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1"
            android:layout_marginLeft="5dp" android:gravity="center" android:text="🏍️&#10;Sürüş" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" android:lines="2"
            android:background="@drawable/widget_btn_bg" />
        <TextView android:id="@+id/widget_btn_park" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1"
            android:layout_marginLeft="5dp" android:gravity="center" android:text="🅿️&#10;Park" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" android:lines="2"
            android:background="@drawable/widget_btn_bg" />
    </LinearLayout>
</LinearLayout>
