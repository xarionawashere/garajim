<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="#171717">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GARAJIM" android:textColor="#F87171" android:textStyle="bold" android:textSize="12sp" />
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Garajım" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="18sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="6dp" />
    <TextView android:id="@+id/widget_plate" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Uygulamayı açıp araç ekleyin" android:textColor="#E5E7EB" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp" />
    <TextView android:id="@+id/widget_km" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Araç takibi" android:textColor="#9CA3AF" android:textSize="12sp" android:layout_marginTop="4dp" />
</LinearLayout>
