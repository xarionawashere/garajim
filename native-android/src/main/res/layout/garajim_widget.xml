<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="13dp" android:background="@drawable/widget_bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="30dp" android:layout_height="30dp" android:gravity="center" android:text="G"
            android:textColor="#FFF4E8" android:textSize="16sp" android:textStyle="bold" android:background="@drawable/widget_mark_bg" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginLeft="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GARAJIM  ·  KONTROL"
                android:textColor="#F2A18A" android:textStyle="bold" android:textSize="9sp" android:letterSpacing="0.08" />
            <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Aracınız" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/widget_switch" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:visibility="gone" android:text="⇄" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold"
            android:paddingLeft="9dp" android:paddingRight="9dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:background="@drawable/widget_chip_bg" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="5dp">
        <TextView android:id="@+id/widget_plate" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Uygulamayı açıp araç ekleyin" android:textColor="#BCC6D2" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_km" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="#F7C47E" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" />
    </LinearLayout>

    <TextView android:id="@+id/widget_service" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:visibility="gone" android:text="" android:textColor="#34D399" android:textSize="11sp" android:textStyle="bold"
        android:maxLines="1" android:ellipsize="end" android:layout_marginTop="6dp" />
    <ProgressBar android:id="@+id/widget_progress_ok" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="5dp" android:max="100" android:progress="0" android:visibility="gone"
        android:progressTint="#5DD6A3" android:progressBackgroundTint="#2B3641" android:layout_marginTop="3dp" />
    <ProgressBar android:id="@+id/widget_progress_warn" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="5dp" android:max="100" android:progress="0" android:visibility="gone"
        android:progressTint="#F6C35B" android:progressBackgroundTint="#2B3641" android:layout_marginTop="3dp" />
    <ProgressBar android:id="@+id/widget_progress_bad" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="5dp" android:max="100" android:progress="0" android:visibility="gone"
        android:progressTint="#F17870" android:progressBackgroundTint="#2B3641" android:layout_marginTop="3dp" />

    <TextView android:id="@+id/widget_alert" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:visibility="gone" android:text="" android:textColor="#F6C35B" android:textSize="10sp"
        android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:layout_marginTop="8dp" android:gravity="bottom">
        <TextView android:id="@+id/widget_btn_fuel" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1"
            android:gravity="center" android:text="⛽&#10;Yakıt" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" android:lines="2"
            android:background="@drawable/widget_btn_bg" />
        <TextView android:id="@+id/widget_btn_km" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1"
            android:layout_marginLeft="5dp" android:gravity="center" android:text="🛣️&#10;KM" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" android:lines="2"
            android:background="@drawable/widget_btn_bg" />
        <TextView android:id="@+id/widget_btn_service" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1"
            android:layout_marginLeft="5dp" android:gravity="center" android:text="🔧&#10;Bakım" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" android:lines="2"
            android:background="@drawable/widget_btn_bg" />
        <TextView android:id="@+id/widget_btn_ride" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1"
            android:layout_marginLeft="5dp" android:gravity="center" android:text="🏍️&#10;Sürüş" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" android:lines="2"
            android:background="@drawable/widget_btn_bg" />
        <TextView android:id="@+id/widget_btn_park" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1"
            android:layout_marginLeft="5dp" android:gravity="center" android:text="🅿️&#10;Park" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" android:lines="2"
            android:background="@drawable/widget_btn_bg" />
    </LinearLayout>
</LinearLayout>